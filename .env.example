# Anthropic LLM API configuration
ANTHROPIC_API_KEY=your-key-here
SKILLFORGE_MODEL=claude-sonnet-5-5

# SkillForge storage paths
SKILLFORGE_WIKI=skills_wiki
SKILLFORGE_RUNS=runs

# Runner binaries
BLENDER_BIN=blender

# Sandbox execution security (Docker container isolation option)
SKILLFORGE_USE_DOCKER=false
SKILLFORGE_DOCKER_IMAGE=python:3.11-slim
